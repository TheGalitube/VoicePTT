<Window x:Class="VoicePTT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoicePTT" Width="1000" Height="760" MinWidth="900" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#090E0B" Foreground="#E7FFEC"
        FontFamily="Segoe UI" FontSize="13" Loaded="Window_Loaded" Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#E7FFEC"/>
    <SolidColorBrush x:Key="Muted" Color="#8FAA98"/>
    <SolidColorBrush x:Key="Surface" Color="#111C15"/>
    <SolidColorBrush x:Key="Edge" Color="#2C5538"/>
    <SolidColorBrush x:Key="Mint" Color="#80FFAA"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Mint}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="FieldTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Edge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="22"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Mint}"/><Setter Property="Foreground" Value="#091A0F"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Padding" Value="22,11"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.87"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#24402D"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="13,9"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#192A1F"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#426D4D"/><Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="37"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,0,0,9"/></Style>
    <Style TargetType="Slider"><Setter Property="Foreground" Value="{StaticResource Mint}"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
  </Window.Resources>
  <Grid x:Name="AppFrame">
  <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" Opacity="0">
    <ScrollViewer.RenderTransform><TranslateTransform x:Name="MainRise" Y="18"/></ScrollViewer.RenderTransform>
    <Grid Margin="30,26,30,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="50" Height="50" CornerRadius="5" Background="#173825" BorderBrush="#62CB7E" BorderThickness="1" Margin="0,0,15,0">
          <Viewbox Margin="10"><Canvas Width="30" Height="30">
            <Border Canvas.Left="10" Canvas.Top="3" Width="10" Height="16" CornerRadius="5" Background="#7CE5C2"/>
            <Path Data="M 5,14 C 5,29 25,29 25,14 M 15,24 L 15,29 M 8,29 L 22,29" Stroke="#7CE5C2" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Canvas></Viewbox>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="GlitchTitle" Text="VOICEPTT.EXE" FontFamily="Consolas" Foreground="{StaticResource Mint}" FontSize="27" FontWeight="Bold"/><TextBlock Text="LOCAL MICROPHONE CONTROL // SYSTEM READY" Style="{StaticResource MutedText}" FontFamily="Consolas"/></StackPanel>
        <Border x:Name="AlertChip" Grid.Column="2" CornerRadius="3" BorderBrush="#A73C50" BorderThickness="1" Background="#32141E" Padding="12,7" VerticalAlignment="Center">
          <TextBlock Text="v2.1 // UNLOCKED" Foreground="#FF7888" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
        </Border>
      </Grid>
      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="25">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="LIVE STATUS" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/><TextBlock x:Name="StateText" Text="OFFLINE" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="DetailText" Text="Press Enable to start" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
          <Button x:Name="EnableButton" Grid.Column="1" Content="Enable VoicePTT" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="EnableButton_Click"/>
          <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,24,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Microphone level" Style="{StaticResource MutedText}"/>
            <TextBlock x:Name="LevelText" Grid.Column="1" Text="— dB" Foreground="{StaticResource Mint}" FontWeight="SemiBold"/>
            <ProgressBar x:Name="LevelMeter" Grid.Row="1" Grid.ColumnSpan="2" Height="12" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Mint}" Background="#2A3B40" BorderThickness="0"/>
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0">
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="01 / INPUT" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
            <TextBlock Text="Microphone" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="DeviceCombo" SelectionChanged="DeviceCombo_SelectionChanged"/>
              <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Click="RefreshDevicesButton_Click"/>
            </Grid>
            <TextBlock Text="Audio stays on this PC. VoicePTT only reads its volume level." Style="{StaticResource MutedText}" Margin="0,11,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="02 / ACTIVATION" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
            <TextBlock Text="Talk behavior" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <ComboBox x:Name="ModeCombo" SelectionChanged="ModeCombo_SelectionChanged"><ComboBoxItem Content="Voice activity"/><ComboBoxItem Content="Tap-to-talk"/><ComboBoxItem Content="Hold-to-talk"/></ComboBox>
            <TextBlock x:Name="ModeDescription" Style="{StaticResource MutedText}" Margin="0,10,0,16"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Activation level" Style="{StaticResource FieldTitle}"/><TextBlock x:Name="ThresholdValue" Grid.Column="1" Foreground="{StaticResource Mint}"/></Grid>
            <Slider x:Name="ThresholdSlider" Minimum="-60" Maximum="-15" TickFrequency="1" ValueChanged="ThresholdSlider_ValueChanged"/>
            <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Release level" Style="{StaticResource FieldTitle}"/><TextBlock x:Name="ReleaseValue" Grid.Column="1" Foreground="{StaticResource Mint}"/></Grid>
            <Slider x:Name="ReleaseSlider" Minimum="-70" Maximum="-15" TickFrequency="1" ValueChanged="ReleaseSlider_ValueChanged"/>
            <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Release delay" Style="{StaticResource FieldTitle}"/><TextBlock x:Name="DelayValue" Grid.Column="1" Foreground="{StaticResource Mint}"/></Grid>
            <Slider x:Name="DelaySlider" Minimum="0" Maximum="1500" TickFrequency="50" ValueChanged="DelaySlider_ValueChanged"/>
            <Grid x:Name="TapWindowRow" Margin="0,15,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Tap activation window" Style="{StaticResource FieldTitle}"/><TextBlock x:Name="TapWindowValue" Grid.Column="1" Foreground="{StaticResource Mint}"/>
              <Slider x:Name="TapWindowSlider" Grid.Row="1" Grid.ColumnSpan="2" Minimum="200" Maximum="3000" TickFrequency="100" ValueChanged="TapWindowSlider_ValueChanged"/>
            </Grid>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="03 / KEYBOARD" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
            <TextBlock Text="PTT key and hotkey" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <TextBlock Text="Key sent to your game or app" Style="{StaticResource FieldTitle}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="TargetKeyCombo" SelectionChanged="TargetKeyCombo_SelectionChanged"/><Button x:Name="RecordTargetButton" Grid.Column="1" Content="Record" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Click="RecordTargetButton_Click"/></Grid>
            <TextBlock Text="Set the same PTT key inside your game or chat app. Scroll Lock is available." Style="{StaticResource MutedText}" Margin="0,9,0,16"/>
            <TextBlock Text="Global control hotkey" Style="{StaticResource FieldTitle}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#28363A" BorderBrush="#42575B" BorderThickness="1" CornerRadius="5" Padding="11,9"><TextBlock x:Name="HotkeyText" Text="Ctrl+Alt+V" FontWeight="SemiBold"/></Border><Button x:Name="RecordHotkeyButton" Grid.Column="1" Content="Record" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Click="RecordHotkeyButton_Click"/></Grid>
            <Button Content="Use Scroll Lock as hotkey" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ScrollLockButton_Click"/>
            <TextBlock x:Name="HotkeyDescription" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="04 / PREFERENCES" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
            <TextBlock Text="When VoicePTT runs" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <CheckBox x:Name="LaunchCheck" Content="Launch when I sign in to Windows" Checked="LaunchCheck_Changed" Unchecked="LaunchCheck_Changed"/>
            <CheckBox x:Name="TrayCheck" Content="Keep running in the tray when I close this window" Checked="TrayCheck_Changed" Unchecked="TrayCheck_Changed"/>
            <TextBlock Text="The tray icon lets you reopen the window or exit the app at any time." Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
          </StackPanel></Border>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="3" Margin="2,19,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusMessage" Text="Ready to configure" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="NO ACCOUNT · NO PAYWALL · NO AUDIO UPLOADS" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/></Grid>
    </Grid>
  </ScrollViewer>
  <Rectangle IsHitTestVisible="False" Opacity="0.07">
    <Rectangle.Fill>
      <DrawingBrush TileMode="Tile" Viewport="0,0,8,6" ViewportUnits="Absolute" Viewbox="0,0,8,6" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing><GeometryDrawing Brush="#80FFAA" Geometry="M 0,0 L 8,0 8,1 0,1 Z"/></DrawingBrush.Drawing>
      </DrawingBrush>
    </Rectangle.Fill>
  </Rectangle>
  <Grid x:Name="BootOverlay" Background="#060B08">
    <Border Width="600" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#376B42" BorderThickness="1" Background="#101B13" Padding="34,30">
      <StackPanel>
        <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="[ VOICEPTT.EXE ]" Foreground="#80FFAA" FontFamily="Consolas" FontSize="17" FontWeight="Bold"/>
          <TextBlock Grid.Column="1" Text="● LOCAL SESSION" Foreground="#FF7888" FontFamily="Consolas" FontSize="11"/>
        </Grid>
        <Rectangle Fill="#376B42" Height="1" Margin="0,0,0,22"/>
        <TextBlock x:Name="BootConsole" Text="_" Foreground="#B6FFC7" FontFamily="Consolas" FontSize="20" Height="120" TextWrapping="Wrap"/>
        <ProgressBar x:Name="BootProgress" Minimum="0" Maximum="100" Value="0" Height="7" Foreground="#80FFAA" Background="#223A29" BorderThickness="0" Margin="0,7,0,14"/>
        <TextBlock Text="NO ACCOUNT  /  NO PAYWALL  /  YOUR AUDIO STAYS LOCAL" Foreground="#73937C" FontFamily="Consolas" FontSize="11"/>
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>
